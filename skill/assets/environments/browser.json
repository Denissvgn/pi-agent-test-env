{
  "schema": 1,
  "required_commands": [
    "chromium"
  ],
  "probes": [
    {
      "name": "linux-platform",
      "argv": [
        "python3",
        "-c",
        "import platform; assert platform.system() == \"Linux\"; print(platform.machine())"
      ]
    },
    {
      "name": "chromium-version",
      "argv": [
        "chromium",
        "--version"
      ],
      "stdout_regex": "Chromium"
    }
  ]
}
