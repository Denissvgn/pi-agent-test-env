{
  "schema": 1,
  "name": "bounded-timeout-demonstration",
  "required_paths": [
    "services/api/SPEC.md",
    "services/api/slug.py",
    "services/api/tests/test_slug.py"
  ],
  "protected_paths": [
    "services/api/SPEC.md",
    "services/api/tests"
  ],
  "agents": [
    {
      "name": "implementer",
      "cwd": "services/api",
      "prompt": "First use bash to execute sleep 20, a declared bounded timeout stimulus. Only after it returns, read SPEC.md and tests/test_slug.py with read, implement slug.py, and run python3 /opt/pi-lab/verify-unittest.py --start-dir tests. Never modify specification or tests. Report actual results.",
      "tools": [
        "read",
        "write",
        "edit",
        "bash"
      ],
      "require_tools": [
        "read",
        "bash"
      ],
      "access": "rw",
      "timeout_seconds": 120,
      "max_turns": 12,
      "max_total_tokens": 60000
    }
  ],
  "checks": [
    {
      "name": "external-oracle",
      "cwd": "services/api",
      "argv": [
        "python3",
        "/opt/pi-scorer/oracle.py"
      ],
      "network": "none",
      "timeout_seconds": 30,
      "scorer": {
        "schema": 1,
        "id": "ascii-slug-oracle",
        "version": "1",
        "assets": [
          {
            "source": "oracle.py",
            "target": "oracle.py"
          },
          {
            "source": "cases.json",
            "target": "cases.json"
          },
          {
            "source": "subject_call.py",
            "target": "subject_call.py"
          }
        ],
        "score_domain": {
          "min": 0,
          "max": 1,
          "direction": "higher",
          "pass_threshold": 1
        },
        "required_assertions": [
          "words",
          "runs-edges",
          "empty",
          "ascii-digits",
          "unicode-lower",
          "types",
          "idempotent",
          "separators"
        ],
        "test_counts_required": true,
        "zero_test_policy": "fail",
        "all_skipped_policy": "fail"
      }
    }
  ]
}
